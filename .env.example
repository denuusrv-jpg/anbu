# Kopiere diese Datei nach .env.local (wird nicht committet) und trage eigene Werte ein.
# Auf Vercel: Project Settings -> Environment Variables.

# Passwort für den geheimen Admin-Zugang (/admin). Lang und zufällig wählen, nur Buchstaben und Zahlen.
ADMIN_SECRET_KEY=

# Supabase (Project Settings -> API im Supabase-Dashboard)
# URL und Anon-Key sind öffentlich gedacht, der Schutz kommt von den RLS-Regeln aus supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GEHEIM: Service-Role-Key umgeht alle Schutzregeln. Nur serverseitig, niemals mit NEXT_PUBLIC_ davor.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: öffentliche Adresse der Seite (für die Links in den E-Mails), z. B. https://dspora.vercel.app
# NEXT_PUBLIC_SITE_URL=

# Geheimnis für den täglichen Aufräum-Job (/api/cron/purge). Vercel schickt es automatisch mit.
CRON_SECRET=

# Optional: KI (OpenAI gpt-4o-mini über das Vercel AI SDK) für die Folgefragen im Onboarding-Chat und den Admin-Copilot.
# GEHEIM: Nur serverseitig. Ohne Schlüssel läuft alles regelbasiert weiter. Den Schlüssel unter platform.openai.com anlegen
# und nur hier bzw. bei Vercel eintragen, nie im Code oder in Nachrichten.
OPENAI_API_KEY=
# Optional: Claude (Sonnet 5.5) für die Auswertung nach dem Gespräch (Werte-Tags, Match-Begründung).
# GEHEIM: Nur serverseitig. Schlüssel unter platform.claude.com (Console) anlegen, dort ein monatliches Ausgabenlimit setzen,
# und nur hier bzw. bei Vercel eintragen, nie im Code oder in Nachrichten.
ANTHROPIC_API_KEY=
# Optional: grobe Obergrenze für KI-Aufrufe pro Tag (Kostenbremse), Standard 3000
# AI_DAILY_LIMIT=3000

# Optional: E-Mail bei neuem Chat (Resend, Absender info@dspora.de). GEHEIM, nur serverseitig. Schlüssel mit reiner Sende-Berechtigung
# unter resend.com anlegen. Ohne Schlüssel werden keine Benachrichtigungen verschickt.
RESEND_API_KEY=
