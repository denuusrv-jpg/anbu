# Kopiere diese Datei nach .env.local (wird nicht committet) und trage eigene Werte ein.
# Auf Vercel: Project Settings -> Environment Variables.

# Passwort für den geheimen Admin-Zugang (/admin). Lang und zufällig wählen.
ADMIN_SECRET_KEY=

# Optional: auf "false" setzen, um den schwebenden Test-Button auszublenden.
# NEXT_PUBLIC_SHOW_TEST_BUTTON=false
