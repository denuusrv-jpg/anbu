# Kopiere diese Datei nach .env.local (wird nicht committet) und trage eigene Werte ein.
# Auf Vercel: Project Settings -> Environment Variables.

# Passwort für den geheimen Admin-Zugang (/admin). Lang und zufällig wählen, nur Buchstaben und Zahlen.
ADMIN_SECRET_KEY=

# Supabase (Project Settings -> API im Supabase-Dashboard)
# URL und Anon-Key sind öffentlich gedacht, der Schutz kommt von den RLS-Regeln aus supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GEHEIM: Service-Role-Key umgeht alle Schutzregeln. Nur serverseitig, niemals mit NEXT_PUBLIC_ davor.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: öffentliche Adresse der Seite (für die Links in den E-Mails), z. B. https://dspora.vercel.app
# NEXT_PUBLIC_SITE_URL=

# Geheimnis für den täglichen Aufräum-Job (/api/cron/purge). Vercel schickt es automatisch mit.
CRON_SECRET=
